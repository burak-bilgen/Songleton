# ==============================================================================
# Songleton release credentials — EXAMPLE ONLY. No real secrets here.
#
# Copy this file to `.env.release` (gitignored) and fill in your values, then
# load it with:  set -a; source .env.release; set +a
# Never commit `.env.release`, never paste secrets into the terminal history.
#
# The same variable names are consumed by the GitHub Actions workflow
# (as repository secrets), so the local flow matches the CI flow exactly.
# ==============================================================================

# Developer ID Application certificate (optional locally):
# Either leave the .p12 file in the keychain and set the identity name, or
# keep the identity empty and let scripts/release.sh auto-detect the single
# "Developer ID Application" identity from the keychain.
#
# In GitHub Actions this comes from the MACOS_CERTIFICATE secret (base64 .p12)
# plus MACOS_CERTIFICATE_PASSWORD; it is imported into a temporary keychain.
#DEVELOPER_ID_APPLICATION=Developer ID Application: Your Name (TEAMID)

# Apple Developer team identifier (must match the certificate team).
#DEVELOPMENT_TEAM=YOUR_TEAM_ID

# --- Notarization: choose ONE of the two schemes ------------------------------

# Option A: App Store Connect API key (preferred, works in CI).
#   APPLE_API_KEY_ID       — API key ID (e.g. ABC1234567)
#   APPLE_API_ISSUER_ID    — API key issuer ID (UUID)
#   APPLE_API_PRIVATE_KEY_PATH — absolute path to AuthKey_<KEY_ID>.p8
# In GitHub Actions the .p8 contents are stored as the base64-encoded secret
# APPLE_API_PRIVATE_KEY and the workflow reconstructs the file itself.
#APPLE_API_KEY_ID=
#APPLE_API_ISSUER_ID=
#APPLE_API_PRIVATE_KEY_PATH=/Users/you/Downloads/AuthKey_ABC1234567.p8

# Option B: keychain profile (local only; requires interactive credentials).
#   xcrun notarytool store-credentials <profile> --key <key.p8> --key-id <id> --issuer <issuer>
#NOTARY_PROFILE=songleton
