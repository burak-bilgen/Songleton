    "onboarding.step_1_title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Welcome to Songleton" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Songleton'a Hoş Geldiniz" } } } },
    "onboarding.step_1_subtitle" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Your quiet, powerful music companion living right in your macOS menu bar." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "macOS menü çubuğunuzda yaşayan sessiz ama güçlü müzik asistanınız." } } } },
    "onboarding.step_2_title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Hover Panel & Quick Triggers" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Hover Paneli ve Hızlı Erişim" } } } },
    "onboarding.step_2_subtitle" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Hover over the menu bar item to reveal full controls and instant gestures." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Menü çubuğu öğesinin üzerine gelerek tüm kontrolleri ve anlık kısayolları görün." } } } },
    "onboarding.step_3_title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Cinematic Ambient Mode" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Sinematik Ambient Modu" } } } },
    "onboarding.step_3_subtitle" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Transform your display into a vibrant music canvas with live synced lyrics." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Ekranınızı canlı senkronize sözlerle renkli bir müzik tuvaline dönüştürün." } } } },
    "onboarding.step_4_title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Hold & Drag Gestures" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bekletme ve Sürükleme Hareketleri" } } } },
    "onboarding.step_4_subtitle" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Rest the cursor at the left, right or top of the screen to control playback; drag to adjust the volume." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "İmleci ekranın solunda, sağında ya da en üstünde bekletip sürükleyerek müziği rahatça kontrol edin." } } } },
    "onboarding.step_5_title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Permissions & Ready" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "İzinler ve Hazırlık" } } } },
    "onboarding.step_5_subtitle" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Grant macOS Automation & Accessibility access to enable full player controls." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Tüm oynatıcı kontrolleri için macOS Otomasyon ve Erişilebilirlik izinlerini verin." } } } },
