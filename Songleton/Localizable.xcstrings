    "tutorial.prompt_subtitle" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Let's quickly try out screen edge gestures and music controls together." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Ekran kenarlarında fareyi nasıl kullanacağınızı ve müzik kontrollerini kısaca deneyelim." } } } },
    "tutorial.prompt_bullet_1" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Screen Edge Gestures (Next, Previous, Play/Pause)" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Ekran Kenarı Hareketleri (İleri, Geri, Oynat/Durdur)" } } } },
    "tutorial.prompt_bullet_2" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "⌘ + ⌥ Keyboard & Dual-Click Volume Control" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "⌘ + ⌥ Klavye ve Çift Fare Tuşu ile Ses Ayarı" } } } },
    "tutorial.prompt_bullet_3" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Cancel Gesture Feature" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "İsteğe Bağlı İptal Hareketi" } } } },
    "tutorial.prompt_start" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Show Me 🚀" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Göster 🚀" } } } },
    "tutorial.prompt_skip" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Not Now" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Şimdi Değil" } } } },
    "tutorial.volume_keyboard_header" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Keyboard + Drag Volume" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Klavye + Sürükleme ile Ses Ayarı" } } } },
    "tutorial.volume_keyboard_desc" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Hold ⌘ (Command) + ⌥ (Option) and drag vertically anywhere on screen to adjust volume." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "⌘ (Command) + ⌥ (Option) tuşlarına basılı tutarken dikey sürükleyerek sesi ayarlayın." } } } },
    "tutorial.volume_mouse_header" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Dual Mouse Buttons Volume" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Çift Fare Tuşu ile Ses Ayarı" } } } },
    "tutorial.volume_mouse_desc" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Press and hold both mouse buttons, then drag vertically. Watch the volume bar follow your hand." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Farenin iki tuşuna aynı anda basılı tut, sonra dikey sürükle. Ses çubuğunun hareketini canlı olarak izle." } } } },
    "tutorial.volume_control_header" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Adjust Volume Anywhere" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Sesi Her Yerden Ayarla" } } } },
    "tutorial.volume_control_desc" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Hold Command and Option, then drag vertically. The real Songleton volume HUD follows the gesture live." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Command ve Option'a basılı tutup dikey sürükle. Songleton'ın gerçek ses HUD'ı hareketi canlı takip eder." } } } },
    "tutorial.volume_drag_short" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Drag vertically" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Dikey sürükle" } } } },
    "tutorial.volume_mouse_alternative" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Or hold both mouse buttons and drag." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Ya da iki fare tuşuna basılı tutup sürükle." } } } },
    "tutorial.hover_menu_header" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Open the Hover Menu" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Hover menüyü aç" } } } },
    "tutorial.hover_menu_desc" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The left button skips to the next track and the right button goes back. Left-click the track name to play or pause, or hover to open the control panel." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Sol buton sonraki şarkıya geçirir, sağ buton önceki şarkıya döner. Şarkı adına sol tıkla oynat veya duraklat; üzerine gelince kontrol paneli açılır." } } } },
    "tutorial.ambient_mode_header" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Enter Ambient Mode" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Ambient Mode'a geç" } } } },
    "tutorial.ambient_mode_desc" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Right-click the track name in the menu bar to turn your music into a full-screen scene." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Menü çubuğundaki şarkı adına sağ tıkla. Müzik tam ekran bir sahneye dönüşsün." } } } },
    "tutorial.stage_hover_menu" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Hover Menu" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Hover Menü" } } } },
    "tutorial.stage_ambient_mode" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Ambient Mode" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Ambient Mode" } } } },
    "tutorial.hover_dummy_accessibility" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Dummy menu bar controls for Midnight Drive by Neon Coast. The left button skips forward, the right button goes back, and clicking the track name plays or pauses." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Neon Coast'un Midnight Drive şarkısı için örnek menü barı kontrolleri. Sol buton ileri, sağ buton geri gider; şarkı adına tıklamak oynatır veya duraklatır." } } } },
