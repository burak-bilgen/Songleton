    "onboarding.tip_artwork_hint" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Bring the music app to the front." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Müzik uygulamasını öne getirir." } } } },
    "onboarding.tip_copy_title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Click the Track Name" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Şarkı Adına Tıklayın" } } } },
