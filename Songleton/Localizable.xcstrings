    "onboarding.tip_menu_hint" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Hover for the full panel; click the track area to play or pause." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Tam panel için üzerine gelin; oynatmak veya duraklatmak için şarkı alanına tıklayın." } } } },
    "onboarding.tip_artwork_title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Click the Artwork" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Albüm Kapağına Tıklayın" } } } },
    "onboarding.tip_artwork_hint" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Bring the music app to the front." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Müzik uygulamasını öne getirir." } } } },
    "onboarding.tip_copy_title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Click the Track Name" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Şarkı Adına Tıklayın" } } } },
    "onboarding.tip_copy_hint" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Copy the current track to the clipboard." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Çalan şarkıyı panoya kopyalar." } } } },
    "settings.track_notifications" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Track change notifications" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Şarkı değişim bildirimleri" } } } },
    "settings.track_notifications_hint" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Show a HUD when the track changes" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Şarkı değiştiğinde ekranda bildirim göster" } } } },
    "settings.horizontal_gestures" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Hold & Skip — Previous/Next Track" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Beklet ve Atlat — Önceki/Sonraki Şarkı" } } } },
    "settings.horizontal_gestures_hint" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Rest the cursor against the left or right side of the screen for half a second: left plays the previous track, right skips to the next." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "İmleci ekranın solunda ya da sağında yarım saniye bekletin: solda önceki şarkı, sağda sonraki şarkı çalar." } } } },
