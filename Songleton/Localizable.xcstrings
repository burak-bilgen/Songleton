    "onboarding.step_2_subtitle" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Hover over the menu bar item to unveil full controls and instant gestures." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Tam kontrolleri ve kestirmeleri görmek için fareyle menü çubuğunun üzerine gelin." } } } },
