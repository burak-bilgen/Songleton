    "settings.horizontal_gestures" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Hold & Skip: Previous/Next Track" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Beklet ve Atlat: Önceki/Sonraki Şarkı" } } } },
    "settings.horizontal_gestures_hint" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Rest the cursor against the left or right side of the screen for half a second: left plays the previous track, right skips to the next." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "İmleci ekranın solunda ya da sağında yarım saniye bekletin: solda önceki şarkı, sağda sonraki şarkı çalar." } } } },
    "settings.vertical_gestures" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Hold & Control: Play/Pause & Volume" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Beklet ve Kontrol Et: Oynat/Duraklat ve Ses" } } } },
    "settings.edge_gesture_duration" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Edge hold duration" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Kenar bekleme süresi" } } } },
    "settings.edge_gesture_duration_hint" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Time required before an edge gesture triggers" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Kenar gesture'ının tetiklenmesi için gereken süre" } } } },
    "settings.vertical_gestures_hint" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Rest the cursor against the very top of the screen for half a second to pause or resume. For volume, hold both mouse buttons (⌘+⌥) and drag up or down." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Duraklatmak ya da yeniden oynatmak için imleci ekranın en üstünde yarım saniye bekletin. Sesi değiştirmek için iki tuşa birden basılı tutun (⌘+⌥) ve yukarı veya aşağı sürükleyin." } } } },
    "settings.shortcuts_guide" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Shortcuts & Gestures Guide" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Kısayollar ve Hareketler Rehberi" } } } },
    "settings.keyboard_shortcuts_title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "KEYBOARD SHORTCUTS (AMBIENT MODE)" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "KLAVYE KISAYOLLARI (AMBIENT MODE)" } } } },
    "settings.gestures_title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "SCREEN & MOUSE GESTURES" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "EKRAN VE FARE HAREKETLERİ" } } } },
    "shortcut.play_pause" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Play / Pause" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Oynat / Durdur" } } } },
    "shortcut.prev_next_track" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Previous / Next track" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Önceki / Sonraki şarkı" } } } },
    "shortcut.volume_control" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Volume up / down (±10%)" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Sesi artır / azalt (±%10)" } } } },
    "shortcut.toggle_lyrics" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Toggle live synced lyrics" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Canlı senkronize sözleri aç / kapat" } } } },
    "shortcut.cycle_themes" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Cycle theme (Vinyl / Cassette / Glass)" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Temayı değiştir (Plak / Kaset / Cam)" } } } },
    "shortcut.exit_ambient" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Exit Ambient Mode" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Ambient moddan çık" } } } },
    "gesture.left_action" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Left side of the screen" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Ekranın sol tarafı" } } } },
    "gesture.left_desc" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Hold at the left side for %@ → Previous track" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Solda %@ bekletin → Önceki şarkı" } } } },
    "gesture.right_action" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Right side of the screen" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Ekranın sağ tarafı" } } } },
    "gesture.right_desc" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Hold at the right side for %@ → Next track" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Sağda %@ bekletin → Sonraki şarkı" } } } },
    "gesture.top_action" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Top of the screen" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Ekranın en üstü" } } } },
    "gesture.top_desc" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Hold at the very top for %@ → Play / Pause" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "En üstte %@ bekletin → Oynat / Duraklat" } } } },
    "gesture.volume_action" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Left + Right Click / ⌘ ⌥" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Sol + Sağ Tık / ⌘ ⌥" } } } },
    "gesture.volume_desc" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Hold both buttons (or ⌘+⌥) and drag up or down → Volume" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "İki tuşa birden basılı tutun (veya ⌘+⌥) ve yukarı/aşağı sürükleyin → Ses ayarı" } } } },
    "onboarding.step_1_title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Welcome to Songleton" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Songleton'a Hoş Geldiniz" } } } },
    "onboarding.step_1_subtitle" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Your quiet, powerful music companion living right in your macOS menu bar." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "macOS menü çubuğunuzda yaşayan sessiz ama güçlü müzik asistanınız." } } } },
    "onboarding.step_2_title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Hover Panel & Quick Triggers" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Hover Paneli ve Hızlı Erişim" } } } },
    "onboarding.step_2_subtitle" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Hover over the menu bar item to reveal full controls and instant gestures." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Menü çubuğu öğesinin üzerine gelerek tüm kontrolleri ve anlık kısayolları görün." } } } },
    "onboarding.step_3_title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Cinematic Ambient Mode" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Sinematik Ambient Modu" } } } },
    "onboarding.step_3_subtitle" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Transform your display into a vibrant music canvas with live synced lyrics." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Ekranınızı canlı senkronize sözlerle renkli bir müzik tuvaline dönüştürün." } } } },
    "onboarding.step_4_title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Hold & Drag Gestures" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bekletme ve Sürükleme Hareketleri" } } } },
    "onboarding.step_4_subtitle" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Rest the cursor at the left, right or top of the screen to control playback; drag to adjust the volume." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "İmleci ekranın solunda, sağında ya da en üstünde bekletip sürükleyerek müziği rahatça kontrol edin." } } } },
    "onboarding.step_5_title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Permissions & Ready" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "İzinler ve Hazırlık" } } } },
    "onboarding.step_5_subtitle" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Grant macOS Automation & Accessibility access to enable full player controls." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Tüm oynatıcı kontrolleri için macOS Otomasyon ve Erişilebilirlik izinlerini verin." } } } },
    "onboarding.right_click_hint" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Right-click the menu bar icon to open Ambient Mode instantly!" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Menü çubuğu ikonuna sağ tıklayarak Ambient modunu anında açın!" } } } },
    "onboarding.double_click_hint" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Double-click the artwork in the hover panel to switch to Ambient Mode." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Hover panelindeki albüm kapağına çift tıklayarak Ambient moduna geçebilirsiniz." } } } },
    "onboarding.right_click_title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Right-click for Ambient Mode" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Ambient mod için sağ tık" } } } },
    "onboarding.double_click_title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Double-click the artwork" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Albüm kapağına çift tıklayın" } } } },
    "setup_recovery.title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Songleton needs one quick setup step" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Songleton için kısa bir kurulum gerekiyor" } } } },
    "setup_recovery.subtitle" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Connect Spotify or Apple Music when you are ready. Until then, Songleton stays out of your way." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Hazır olduğunda Spotify veya Apple Music'i bağla. O zamana kadar Songleton seni rahatsız etmez." } } } },
    "setup_recovery.continue" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Continue setup" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Kuruluma devam et" } } } },
    "setup_recovery.quit" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Quit Songleton" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Songleton'dan çık" } } } },
    "onboarding.language_picker_title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Language" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Dil" } } } },
    "onboarding.screen_controls_title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Your music is one move away" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Müziğin tek hamle uzağında" } } } },
    "onboarding.screen_controls_subtitle" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Songleton lives in the menu bar, so it is there without pulling you out of what you are doing." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Songleton menü çubuğunda yaşar. İşini bölmeden müziğine ulaşmanı sağlar." } } } },
    "onboarding.screen1_title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Keep your music flowing" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Müziğin akışını bölme" } } } },
    "onboarding.screen1_subtitle" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Open Spotify or Apple Music. Songleton keeps playback close while you stay in the app you're using." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Spotify veya Apple Music'i aç. Songleton, kullandığın uygulamadan çıkmadan müziği kontrol etmene yardım etsin." } } } },
    "onboarding.feature_gestures_title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Leave the cursor at the edge" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "İmleci kenara bırak" } } } },
    "onboarding.feature_gestures_desc" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Left edge: previous track. Right edge: next track. Top edge: play or pause." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Sol kenar: önceki şarkı. Sağ kenar: sonraki şarkı. Üst kenar: oynat veya duraklat." } } } },
    "onboarding.feature_menubar_title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "See and control what's playing" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Çalanı gör, hemen kontrol et" } } } },
    "onboarding.feature_menubar_desc" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The track, artist, and playback controls stay one click away in the menu bar." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Şarkı, sanatçı ve oynatma kontrolleri menü çubuğunda tek tık uzağında." } } } },
    "onboarding.feature_ambient_title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Give your music a full screen" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Müziğine tam ekran ver" } } } },
    "onboarding.feature_ambient_desc" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Turn artwork, themes, and synced lyrics into a calm visual space." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Albüm kapağını, temaları ve senkronize sözleri sakin bir görsel alana dönüştür." } } } },
    "onboarding.screen2_title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Connect your music, we’ll handle the rest" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Müziğini bağla, gerisini biz halledelim" } } } },
    "onboarding.screen2_subtitle" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Connect at least one music player so Songleton can read and control playback. Accessibility is only for gestures." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Songleton'ın müziği okuyup kontrol edebilmesi için en az bir uygulamayı bağla. Erişilebilirlik yalnızca hareketler için gerekli." } } } },
    "onboarding.permission_automation_hint" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Connect this player to read tracks and control playback." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Şarkıları okuyup oynatmayı kontrol etmek için bu uygulamayı bağla." } } } },
