    "settings.track_notifications_hint" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Show a HUD when the track changes" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Şarkı değiştiğinde ekranda bildirim göster" } } } },
