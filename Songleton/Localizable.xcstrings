    "spotify.discovery_play_hint" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Open in Spotify and start shuffled playback" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Spotify'da aç ve karıştırarak çal" } } } },
