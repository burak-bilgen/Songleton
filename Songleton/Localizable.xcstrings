    "settings.vertical_gestures_hint" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Rest the cursor against the very top of the screen for half a second to pause or resume. For volume, hold both mouse buttons (⌘+⌥) and drag up or down." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Duraklatmak ya da yeniden oynatmak için imleci ekranın en üstünde yarım saniye bekletin. Sesi değiştirmek için iki tuşa birden basılı tutun (⌘+⌥) ve yukarı veya aşağı sürükleyin." } } } },
