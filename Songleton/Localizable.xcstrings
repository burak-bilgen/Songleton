    "notification.preview_artist" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Notification preview" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bildirim önizlemesi" } } } },
    "settings.preview_notification" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Show preview" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Önizlemeyi göster" } } } },
    "settings.preview_notification_hint" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Shows a sample notification at the selected position on the current display" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Seçilen konumda, imlecin bulunduğu ekranda örnek bildirim gösterir" } } } },
    "settings.notification_position" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Notification position" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bildirim konumu" } } } },
    "settings.notification_position_hint" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Choose where new-track HUDs appear" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Yeni şarkı bildirimlerinin görüneceği yeri seç" } } } },
    "settings.notification_position.topLeading" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Top left" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Sol üst" } } } },
    "settings.notification_position.top" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Top center" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Üst orta" } } } },
    "settings.notification_position.topTrailing" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Top right" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Sağ üst" } } } },
    "settings.notification_position.leading" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Left center" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Sol orta" } } } },
    "settings.notification_position.trailing" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Right center" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Sağ orta" } } } },
